<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ver_acciones"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tvusuestadisticas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1B263B"
        android:gravity="center"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:text="Nombre Usuario"
        android:textColor="@android:color/white"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="12dp"
        android:text="Estadísticas IoT"
        android:textColor="@color/white"
        android:textSize="24sp"
        android:textStyle="bold" />

    <ListView
        android:id="@+id/lvEstadisticas"
        android:layout_width="320dp"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#E6FFFFFF"
        android:divider="#B0BEC5"
        android:dividerHeight="1dp"
        android:padding="8dp" />

    <Button
        android:id="@+id/btnRefrescarEst"
        android:layout_width="320dp"
        android:layout_height="50dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:backgroundTint="#1B263B"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="Refrescar Estadísticas"
        android:textColor="@android:color/white"
        android:textSize="15sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnVolverEst"
        android:layout_width="320dp"
        android:layout_height="55dp"
        android:layout_marginBottom="24dp"
        android:backgroundTint="#8B0000"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="Volver"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout>